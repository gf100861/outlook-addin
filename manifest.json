{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "1.0.0",
  "id": "7c0bc464-1f42-4e7b-9271-e673a3782772",
  "name": {
    "short": "邮箱助手",
    "full": "智能附件发送助手 (Smart Attachment On-Send Assistant)"
  },
  "description": {
    "short": "Checks for attachments before sending.",
    "full": "This add-in uses Smart Alerts to check if an email mentioning attachments has any files attached before sending."
  },
  "developer": {
    "name": "Louis Xin",
    "websiteUrl": "https://localhost:3000/",
    "privacyUrl": "https://localhost:3000/privacy",
    "termsOfUseUrl": "https://localhost:3000/servicesagreement"
  },
  "icons": {
    "outline": "assets/outline.png",
    "color": "assets/color.png"
  },
  "accentColor": "#230201",
  "authorization": {
    "permissions": {
      "resourceSpecific": [
        {
          "name": "Mailbox.ReadWrite.User",
          "type": "Delegated"
        }
      ]
    }
  },
  "validDomains": [
    "https://localhost:3000/"
  ],
  "extensions": [
    {
      "requirements": {
        "scopes": [
          "mail"
        ],
        "capabilities": [
          {
            "name": "Mailbox",
            "minVersion": "1.9"
          }
        ]
      },
      "runtimes": [
        {
          "id": "CommandsRuntime",
          "type": "general",
          "code": {
            "page": "https://localhost:3000/commands.html",
            "script": "https://localhost:3000/commands.js"
          },
          "lifetime": "long",
          "actions": [
            {
              "id": "onMessageSendHandler",
              "type": "executeFunction",
              "displayName": "onMessageSendHandler"
            }
          ]
        },
        {
          "requirements": {
            "capabilities": [
              {
                "name": "Mailbox",
                "minVersion": "1.3"
              }
            ]
          },
          "id": "TaskPaneRuntime",
          "type": "general",
          "code": {
            "page": "https://localhost:3000/taskpane.html",
            "script": "https://localhost:3000//taskpane.js"
          },
          "lifetime": "short",
          "actions": [
            {
              "id": "TaskPaneRuntimeShow",
              "type": "openPage",
              "pinnable": true,
              "view": "columns"
            }
          ]
        }
      ],
      "autoRunEvents": [
        {
          "requirements": {
            "scopes": [
              "mail"
            ]
          },
          "events": [
            {
              "type": "messageSending",
              "actionId": "onMessageSendHandler",
              "options": {
                "sendMode": "promptUser"
              }
            }
          ]
        }
      ],
      "ribbons": [
        {
          "contexts": [
            "mailCompose"
          ],
          "tabs": [
            {
              "builtInTabId": "TabDefault",
              "groups": [
                {
                  "id": "msgComposeGroup",
                  "label": "邮箱助手",
                  "icons": [
                    {
                      "size": 16,
                      "url": "https://localhost:3000/assets/icon-16.png"
                    },
                    {
                      "size": 32,
                      "url": "https://localhost:3000/assets/icon-32.png"
                    },
                    {
                      "size": 80,
                      "url": "https://localhost:3000/assets/icon-80.png"
                    }
                  ],
                  "controls": [
                    {
                      "id": "comprehensiveToolsMenu",
                      "type": "menu",
                      "label": "邮件工具",
                      "icons": [
                        {
                          "size": 16,
                          "url": "https://localhost:3000/assets/icon-16.png"
                        },
                        {
                          "size": 32,
                          "url": "https://localhost:3000/assets/icon-32.png"
                        },
                        {
                          "size": 80,
                          "url": "https://localhost:3000/assets/icon-80.png"
                        }
                      ],
                      "supertip": {
                        "title": "邮件工具",
                        "description": "访问邮件和附件验证工具."
                      },
                      "actionId": "TaskPaneRuntimeShow",
                      "items": [
                        {
                          "id": "emailValidatorMenuItem",
                          "type": "menuItem",
                          "label": "邮件验证器",
                          "icons": [
                            {
                              "size": 16,
                              "url": "https://localhost:3000/assets/icon-16.png"
                            },
                            {
                              "size": 32,
                              "url": "https://localhost:3000/assets/icon-32.png"
                            },
                            {
                              "size": 80,
                              "url": "https://localhost:3000/assets/icon-80.png"
                            }
                          ],
                          "supertip": {
                            "title": "邮件验证",
                            "description": "打开验证任务窗格."
                          },
                          "actionId": "TaskPaneRuntimeShow"
                        },
                        {
                          "id": "attachmentValidatorMenuItem",
                          "type": "menuItem",
                          "label": "附件验证",
                          "icons": [
                            {
                              "size": 16,
                              "url": "https://localhost:3000/assets/icon-16.png"
                            },
                            {
                              "size": 32,
                              "url": "https://localhost:3000/assets/icon-32.png"
                            },
                            {
                              "size": 80,
                              "url": "https://localhost:3000/assets/icon-80.png"
                            }
                          ],
                          "supertip": {
                            "title": "附件验证",
                            "description": "打开附件验证任务窗格."
                          },
                          "actionId": "TaskPaneRuntimeShow"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}